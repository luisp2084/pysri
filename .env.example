# production | development
PYSRI_ENV=production
# Hashes SHA-256 de las API keys (separados por coma). Genere con: python -m web.keys
PYSRI_API_KEY_HASHES=
# Hosts permitidos (cabecera Host). Agregue su dominio.
PYSRI_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes CORS permitidos (vacío = solo mismo origen)
PYSRI_CORS_ORIGINS=
# Habilitar envío al ambiente de PRODUCCIÓN del SRI
PYSRI_ALLOW_PRODUCTION=false
# Límites
PYSRI_MAX_BODY_BYTES=1048576
PYSRI_MAX_CERT_BYTES=102400
PYSRI_RATE_LIMIT_PER_MINUTE=60
PYSRI_SENSITIVE_RATE_LIMIT_PER_MINUTE=10
# Solo si está detrás de un proxy inverso de confianza (usa X-Forwarded-For)
PYSRI_TRUST_PROXY_HEADERS=false
# SRI
PYSRI_SRI_TIMEOUT=30
PYSRI_SRI_VERIFY_TLS=true
PYSRI_SRI_AUTH_ATTEMPTS=5
PYSRI_SRI_AUTH_DELAY=3
# Solo desarrollo: desactiva la autenticación (ignorado en producción)
PYSRI_AUTH_DISABLED=false
